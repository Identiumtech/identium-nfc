<?xml version="1.0" encoding="utf-8"?>
<!--
    Header gradient mirrors the CRM Login screen
    (bg-gradient-to-br from-brand-dark via-brand-darkblue to-brand-blue).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/brand_dark"
        android:centerColor="@color/brand_darkblue"
        android:endColor="@color/brand_blue"
        android:type="linear" />
</shape>

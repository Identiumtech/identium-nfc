<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background. Brand dark fills the entire 108x108 region;
    a subtle blue diagonal sweep lifts it so the icon isn't a flat block.
    Adaptive icon backgrounds get masked by the launcher into circles /
    squircles, so detail is constrained to the centred 72x72 safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#1a1a2e" android:pathData="M0,0h108v108h-108z" />
    <path
        android:pathData="M0,72 L108,0 L108,108 L0,108 Z"
        android:fillAlpha="0.65">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="108"
                android:endX="108"
                android:endY="0"
                android:type="linear">
                <item android:offset="0.0" android:color="#1a1a2e" />
                <item android:offset="0.55" android:color="#0f2167" />
                <item android:offset="1.0" android:color="#1a3adb" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground. White "I" mark + NFC waves. Lives inside the
    centred 72x72 safe zone of the 108x108 viewport (offset 18..90), so it
    survives every launcher mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Letter "I" — geometric serif slab -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,30 L62,30 L62,40 L55,40 L55,68 L62,68 L62,78 L38,78 L38,68 L45,68 L45,40 L38,40 Z" />

    <!-- NFC wave — concentric arcs to the right of the I -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="1.0"
        android:pathData="M68,46 a8,8 0 0 1 0,16 l0,-3 a5,5 0 0 0 0,-10 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.85"
        android:pathData="M74,40 a14,14 0 0 1 0,28 l0,-3 a11,11 0 0 0 0,-22 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.65"
        android:pathData="M80,34 a20,20 0 0 1 0,40 l0,-3 a17,17 0 0 0 0,-34 Z" />
</vector>

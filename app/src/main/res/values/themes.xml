<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.IdentiumNfc" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary = brand_blue (matches CRM btn-primary). -->
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_blue_100</item>
        <item name="colorOnPrimaryContainer">@color/brand_blue_900</item>

        <!-- Secondary = brand_darkblue, used for header / sidebar surfaces. -->
        <item name="colorSecondary">@color/brand_darkblue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/brand_blue_50</item>
        <item name="colorOnSecondaryContainer">@color/brand_darkblue</item>

        <!-- Tertiary = brand_red — reserved for danger / accent. -->
        <item name="colorTertiary">@color/brand_red</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/brand_red_50</item>
        <item name="colorOnTertiaryContainer">@color/brand_red_dark</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:colorBackground">@color/surface_grey</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_grey_2</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="android:fontFamily">sans-serif</item>

        <item name="materialButtonStyle">@style/Widget.Identium.Button</item>
    </style>

    <style name="Theme.IdentiumNfc.Splash" parent="Theme.IdentiumNfc">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Buttons: rounded-lg (10dp), 44dp min height, like .btn-primary in CRM. -->
    <style name="Widget.Identium.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card: rounded-xl, soft shadow, gray-100 border (matches CRM .card / .stat-card) -->
    <style name="Widget.Identium.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">18dp</item>
    </style>

    <style name="TextAppearance.Identium.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Section header: uppercase, tracked, blue brand color (matches CRM .form-label) -->
    <style name="TextAppearance.Identium.Section" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/brand_blue</item>
    </style>

    <style name="TextAppearance.Identium.Body" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextAppearance.Identium.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Identium.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_blue_100</item>
        <item name="android:height">36dp</item>
        <item name="android:width">64dp</item>
        <item name="marginHorizontal">4dp</item>
    </style>
</resources>

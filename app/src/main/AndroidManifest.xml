<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Minimal permission surface — we only need NFC to operate, plus
        VIBRATE for write-success haptic and legacy storage for the
        Save-QR-to-gallery fallback on pre-Q devices.

        We deliberately do NOT request CALL_PHONE / SEND_SMS / BLUETOOTH /
        WIFI permissions: writing a tel: / smsto: / WiFi: NDEF record is
        just data — the receiving phone prompts before doing anything.
    -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:name=".IdentiumApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IdentiumNfc">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />

            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RecordEditorActivity"
            android:label="@string/add_record"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.PasswordActivity"
            android:label="@string/set_password"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.CopyTagActivity"
            android:label="@string/copy_tag"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.ImportExcelActivity"
            android:label="@string/import_excel"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.CloneTagActivity"
            android:label="@string/clone_tag"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.HistoryActivity"
            android:label="@string/history"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.VerifyTagActivity"
            android:label="@string/verify_tag"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.ProfileActivity"
            android:label="Your business card"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.QuickRecipesActivity"
            android:label="Quick recipes"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.StatsActivity"
            android:label="Statistics"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.DiagnosticActivity"
            android:label="NFC diagnostic"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.AboutActivity"
            android:label="About Identium"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:label="Welcome"
            android:exported="false" />

        <activity
            android:name=".ui.QrCodeActivity"
            android:label="QR code"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.PassportActivity"
            android:label="Digital Passport"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.ChipInspectorActivity"
            android:label="Chip authenticity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.MemoryEditorActivity"
            android:label="Memory editor"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.BulkWriteLockActivity"
            android:label="Bulk write and lock"
            android:parentActivityName=".MainActivity" />

        <!-- For sharing the QR PNG via Intent.ACTION_SEND. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

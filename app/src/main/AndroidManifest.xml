<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:name=".IdentiumApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IdentiumNfc">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />

            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RecordEditorActivity"
            android:label="@string/add_record"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.PasswordActivity"
            android:label="@string/set_password"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.CopyTagActivity"
            android:label="@string/copy_tag"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.ImportExcelActivity"
            android:label="@string/import_excel"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.CloneTagActivity"
            android:label="@string/clone_tag"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.HistoryActivity"
            android:label="@string/history"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.VerifyTagActivity"
            android:label="@string/verify_tag"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.ProfileActivity"
            android:label="Your business card"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.QuickRecipesActivity"
            android:label="Quick recipes"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.StatsActivity"
            android:label="Statistics"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.DiagnosticActivity"
            android:label="NFC diagnostic"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.AboutActivity"
            android:label="About Identium"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:label="Welcome"
            android:exported="false" />
    </application>
</manifest>
